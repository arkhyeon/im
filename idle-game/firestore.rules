rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랭킹을 위해 누구나 읽을 수 있고, 본인 문서만 쓸 수 있어요.
    match /players/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.gold is number
        && request.resource.data.totalEarned is number
        && request.resource.data.equip is map
        && request.resource.data.workers is map;
    }

    // 부산물 시세: 누구나 읽고, 로그인한 유저가 20분마다 갱신
    match /market/byproducts {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.window is int
        && request.resource.data.prices is map;
    }

    // 20분 구간별 판매량
    match /byproduct_trades/{window} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
